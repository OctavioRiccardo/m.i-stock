# ====================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO: miStock (.env.example)
# Copia este archivo como .env.local y completa con tus credenciales reales o de prueba
# ====================================================================

# --------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL, Autenticación GoTrue & Almacenamiento)
# Panel de control: https://supabase.com/dashboard/project/_/settings/api
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui

# --------------------------------------------------------------------
# 2. MERCADO PAGO API (Point Smart, Postnet Cloud, QR y Webhooks)
# Panel de desarrolladores: https://www.mercadopago.com.ar/developers/panel/app
#
# Para pruebas locales o sandbox:
# - Crea una aplicación en el panel de Mercado Pago.
# - En "Credenciales de prueba", copia el Access Token (empieza con "TEST-").
# Para producción:
# - Copia el Access Token de producción (empieza con "APP_USR-").
# --------------------------------------------------------------------
# Access Token privado del backend (necesario para cobrar y consultar estado)
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Clave pública para integración en frontend (opcional)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Clave secreta para verificar firmas de Webhooks (header x-signature)
MERCADOPAGO_WEBHOOK_SECRET=

# [Opcional] ID de terminal Point predeterminada para cobros en caja física
# Ejemplo: PAX_A910__123456789
MERCADOPAGO_POINT_DEVICE_ID=

# --------------------------------------------------------------------
# 3. TRELLO INTEGRATION API (Opcional - Gestión de Backlog / Tablero)
# --------------------------------------------------------------------
TRELLO_API_KEY=
TRELLO_TOKEN=
